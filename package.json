{
  "name": "negocio-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "negocio.com.py — consumer business directory for Paraguay. Next.js (App Router) + TypeScript + Tailwind. SSR over a swappable listings repository (seed → MySQL).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import-seed": "tsx scripts/import-seed.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.44.7",
    "iron-session": "^8.0.4",
    "maplibre-gl": "^4.7.1",
    "mysql2": "^3.23.3",
    "next": "^14.2.35",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "tsx": "^4.23.12",
    "vitest": "^2.1.9"
  },
  "license": "UNLICENSED"
}
