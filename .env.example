# =====================================================================
# negocio.com.py — environment variables
# The site RUNS AND LOOKS COMPLETE on seed data with only the first block.
# Each integration activates by adding its env and redeploying.
# =====================================================================

# --- MINIMUM TO LAUNCH (site runs on seed data with just these) ---
NEXT_PUBLIC_SITE_URL=https://negocio.com.py
NEXT_PUBLIC_WHATSAPP_NUMBER=595XXXXXXXXX        # platform WhatsApp (header/contact), E.164 digits
# First-party reviews (Phase D item 5). `true` shows the approved reviews and the
# submission form on every listing page; it needs DATABASE_URL too, since a
# submission has nowhere to land without one. Leave it false until the reviews
# migration (drizzle/0003_*) has been applied by hand.
NEXT_PUBLIC_REVIEWS_ENABLED=false
NEXT_PUBLIC_PROMO_BANNER=off                      # off | on

# --- DATABASE (MySQL, Phase B) ---
# Hostinger: hPanel → Databases → MySQL, then Remote MySQL to whitelist the app host.
# Server-side only — never exposed to the client. Migrations in ./drizzle are applied
# from a LOCAL machine (see README "Database"), never from a deploy hook.
# tsx does NOT load .env: export this in the shell before running scripts/.
DATABASE_URL=mysql://user:password@host:3306/database

# --- ADMIN SESSIONS (required for /admin and /ingresar) ---
# Seals the session cookie. Generate with: openssl rand -base64 32
# Must be at least 32 characters — the app throws at boot if it is missing or
# short, deliberately: a development default would be a forgeable session.
# Changing it signs everyone out, which is also how you revoke every session.
SESSION_SECRET=

# --- ADD WHEN LEAD ROUTING IS READY (one at a time, redeploy each) ---
GHL_WEBHOOK_URL=
SHEETS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# --- VENDERCRM (ROADMAP F6, optional) ---
# Both are required together — unset (either one), the VenderCRM sink is
# skipped and everything else in lib/leads.ts behaves exactly as before.
# Only `sumate` (has a phone field) reaches VenderCRM as a real contact;
# `contacto` and `listing_whatsapp` leads still fan out to GHL/Sheets above,
# but VenderCRM requires a phone and neither of those sources collects one,
# so they're logged and skipped there rather than sent with a fake phone.
# Get both from VenderCRM → Sitios (the API key is shown exactly once).
VENDERCRM_URL=
VENDERCRM_API_KEY=

# --- MEDIA (Cloudflare R2, listing gallery/cover uploads) ---
# All FIVE are required together — mediaConfigured() checks every one. Unset,
# the gallery UI shows a "falta configurar" notice instead of an upload button;
# the app boots and serves normally either way. Never applied by a deploy hook.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_BASE_URL=                       # public bucket/CDN origin, no trailing slash

# --- MAIL (SMTP, optional) ---
# All FIVE are required together — mailConfigured() checks every one, because a
# half-configured transport does not fail loudly, it hangs on connect. Unset,
# nothing here is ever constructed and the app boots and serves normally; the
# expiry digest endpoint answers 503 so a misconfiguration is visible to the
# operator instead of looking like a healthy run.
#
# Hostinger's own mailboxes work: smtp.hostinger.com, port 465 (implicit TLS).
# Port 465 is treated as secure and anything else as STARTTLS.
#
# This transport is also the PR-6 blocker: password reset by email is the gate
# on ever announcing the owner portal to a real business, and it needs exactly
# this and nothing more.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=                                        # e.g. panel@negocio.com.py
MAIL_STAFF_TO=                                    # comma-separated; falls back to MAIL_FROM

# --- EXPIRY DIGEST (ROADMAP W2-4 / D6) ---
# Hostinger's Node app has no cron, so the weekly "expiring in <=14 days"
# digest is a URL an external scheduler (cron-job.org, UptimeRobot) POSTs once
# a week. This token is the ONLY thing between the public internet and a mail
# send, so generate a real one: `openssl rand -base64 32`.
#
# UNSET MEANS THE ENDPOINT 404s. "Forgot to set it" must never mean "open to
# everyone". Send it as `Authorization: Bearer <token>` where the scheduler
# supports headers, or as `?token=` where it does not.
#
#   POST https://negocio.com.py/api/internal/expiry-digest
EXPIRY_DIGEST_TOKEN=

# --- ERROR MONITORING (Sentry, optional, server-side only) ---
# Create a free Sentry project, then set this and redeploy. Unset, Sentry.init
# runs with enabled:false — no network calls, the app is unaffected either way.
# Deliberately server + edge only, no browser SDK: a client-side Sentry.init
# roughly doubled this app's shared JS bundle (87.8 kB -> 155 kB) for a mostly
# server-rendered directory site where the failures that matter are 500s and
# admin-action errors, not client render errors. Revisit if that changes.
SENTRY_DSN=
# Only needed to upload source maps for readable stack traces; unset skips it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- MAPS (keyless) ---
NEXT_PUBLIC_MAP_TILES=https://tiles.openfreemap.org/styles/positron   # or a CARTO Positron style URL

# --- ANALYTICS (optional, cookieless — no cookie banner needed either way) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                     # e.g. negocio.com.py — leave empty to disable
NEXT_PUBLIC_PLAUSIBLE_SRC=                        # only if self-hosting Plausible; defaults to plausible.io
