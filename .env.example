# =====================================================================
# negocio.com.py — environment variables
# The site RUNS AND LOOKS COMPLETE on seed data with only the first block.
# Each integration activates by adding its env and redeploying.
# =====================================================================

# --- MINIMUM TO LAUNCH (site runs on seed data with just these) ---
NEXT_PUBLIC_SITE_URL=https://negocio.com.py
NEXT_PUBLIC_WHATSAPP_NUMBER=595XXXXXXXXX        # platform WhatsApp (header/contact), E.164 digits
NEXT_PUBLIC_BACKEND=seed                          # seed | jetengine
NEXT_PUBLIC_REVIEWS_ENABLED=false
NEXT_PUBLIC_PROMO_BANNER=off                      # off | on

# --- ADD WHEN BACKEND IS READY ---
NEXT_PUBLIC_PANEL_URL=https://panel.negocio.com.py
WP_APP_USER=                                      # WordPress Application Password user
WP_APP_PASSWORD=                                  # server-side only — never exposed to the client

# --- ADD WHEN LEAD ROUTING IS READY (one at a time, redeploy each) ---
GHL_WEBHOOK_URL=
SHEETS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# --- MAPS (keyless) ---
NEXT_PUBLIC_MAP_TILES=https://tiles.openfreemap.org/styles/positron   # or a CARTO Positron style URL
